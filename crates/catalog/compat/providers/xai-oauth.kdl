// Provider-wire compat for "xai-oauth"; regenerated from the frozen census using deployment contract selectors.

provider "xai-oauth" {
	class "xai" {
		family "grok" {
			// The frozen source rows' legacy compat pins both values, so that flip
			// rides the next snapshot import. The summary rejection and root-union
			// flattening are new axes the legacy compat is silent on.
			filter-reasoning-history #true
			flatten-root-unions #true
			include-encrypted-reasoning #false
			reasoning-effort-map {
				minimal "low"
			}
			supports-image-detail-original #false
			supports-reasoning-summary #false
			thinking-mode "effort"
			revision ">=0.1 <4.3" {
				omit-reasoning-effort #true
			}
			revision ">=4.3 <4.20" {
				omit-reasoning-effort #false
				supports-reasoning-effort #true
			}
		}
	}
	// SuperGrok requires an explicit native effort and defaults to high. The
	// frozen source row's legacy compat pins the effort ladder (including the
	// dead `minimal` alias), so the ladder cleanup rides the next snapshot
	// import; only the default and the mandatory-effort contract apply now.
	models "grok-4.5" {
		thinking-default-level "high"
		thinking-requires-effort #true
	}
	// Dormant until a catalog snapshot ships grok-4.6; xhigh is native there.
	models "grok-4.6" {
		reasoning-effort-map {}
		thinking-efforts "low" "medium" "high" "xhigh"
		thinking-default-level "high"
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*reasoning" "grok-build" {
		omit-reasoning-effort #true
		supports-reasoning-effort #false
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "grok-4.20-multi-agent-0309" {
		omit-reasoning-effort #false
		supports-reasoning-effort #true
	}
}
