// Provider-scoped runtime-discovery vocabulary.

discovery {
	// GMI Cloud's /v1/models returns bare {id} rows for the open-weight
	// models it resells under canonical namespaced ids, so discovery
	// recovers intrinsic base-model parameters (display name, context
	// window, output limit, thinking policy) from the bundled canonical
	// reference index. OpenCode Go additionally recovers intrinsic parameters
	// for its exact gateway-first Responses pins, whose bare ids otherwise carry
	// no capability metadata.
	// Pricing, wire policy, and routes are never borrowed across providers.
	recover-canonical-params "gmi-cloud" "opencode-go" "yolo-auto"
	// The OpenCode gateways share one operator and ship models before any
	// census bundles them (muse-spark-1.2[-contributor] was served only at
	// /responses while unbundled). An unbundled discovered id —
	// or its billing-variant base — that is bundled on either gateway with
	// an openai-responses route materializes on the discovering gateway's
	// responses route instead of the discovery route. Only the responses
	// signal is borrowed: anthropic and chat transports genuinely diverge
	// across the gateways (minimax-m2.5), and pricing never transfers.
	borrow-responses-route "opencode-go" "opencode-zen"
	// Exact gateway-first ids verified on responses before either sibling
	// catalog carried a usable route. The base pin also covers authored
	// billing variants below.
	responses-route-models "opencode-go" "deepseek-v4-flash" "muse-spark-1.2"
	// Billing-variant SKUs sharing a transport with their base id.
	billing-variant-suffix "-free" "-contributor"
}
